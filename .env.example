# Скопируйте этот файл в .env и заполните значения.

# Адрес базы данных PostgreSQL (выдаёт хостинг)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/academy

# Длинная случайная строка (минимум 32 символа) — секрет для входа пользователей
PAYLOAD_SECRET=замените-на-длинную-случайную-строку

# Адрес сайта без слэша в конце
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Почта для писем «смена пароля» (необязательно) ---
# Например, Яндекс Почта для домена: smtp.yandex.ru, порт 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Файловое хранилище S3 (необязательно) ---
# Если заполнено, аудио, PDF и картинки хранятся в S3-хранилище хостинга.
# Если пусто — файлы хранятся на диске сервера в папке /media.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
