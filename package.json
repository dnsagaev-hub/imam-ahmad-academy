{
  "name": "imam-ahmad-academy",
  "version": "0.1.0",
  "description": "Академия имама Ахмада — онлайн-школа ханбалитского фикха",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap && cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint ."
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource/amiri": "^5.2.0",
    "@payloadcms/db-postgres": "3.82.1",
    "@payloadcms/email-nodemailer": "3.82.1",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/storage-s3": "3.82.1",
    "@payloadcms/translations": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "payload": "3.82.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
